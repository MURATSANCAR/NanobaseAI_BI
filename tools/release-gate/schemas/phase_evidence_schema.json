{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NanobasePhaseEvidenceIndex",
  "type": "object",
  "required": ["phases", "release", "generatedAt"],
  "properties": {
    "release": { "type": "string" },
    "generatedAt": { "type": "string" },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "status", "required", "present", "missing"],
        "properties": {
          "phase": { "type": "integer", "minimum": 1, "maximum": 9 },
          "status": {
            "type": "string",
            "enum": ["COMPLETE", "PARTIAL", "MISSING", "LEGACY_ACCEPTED", "OFFLINE_GO", "PENDING_LIVE"]
          },
          "required": { "type": "array", "items": { "type": "string" } },
          "present": { "type": "array", "items": { "type": "string" } },
          "missing": { "type": "array", "items": { "type": "string" } },
          "legacyAccepted": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}