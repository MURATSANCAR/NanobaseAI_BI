# NanobaseAI BI — kurulum ayarları
# install.sh boş bırakılan gizli değerleri (şifre/anahtar) otomatik üretir.

# Dışa açılan HTTP portu (nginx). TLS için önüne kendi reverse proxy'nizi koyun.
PUBLIC_HTTP_PORT=80
# Uygulama alt yol ile sunulacaksa (örn. /bi/) — kök için "/"
WEB_BASE_PATH=/

# Dizinler (göreli yollar bu klasöre göredir)
DATA_DIR=./data
SECRETS_DIR=./secrets
MODELS_DIR=./models

# Kimlik doğrulama: dev = tek kiracı, portal girişi yok; jwt = harici portal JWT'si
# jwt in any deployment that is reachable by anyone but you: dev answers every request as ADMIN.
AUTH_MODE=jwt
DEV_TENANT_ID=default

# --- Gizli değerler (boşsa install.sh üretir) ---
META_DB_PASSWORD=
JWT_SECRET=
QG_SERVICE_JWT_SECRET=
QG_HMAC_SECRET=
EMBED_API_KEY=

# --- LLM (yerel GPU Qwen3.8-27B, OpenAI uyumlu) ---
# Model çağrıları yerel GPU Qwen3.8-27B üzerinden. Müşteri kendi ucunu isterse LLM_API_BASE değişir.
LLM_API_BASE=http://GPU_PRIVATE_HOST:8001/v1
LLM_API_KEY=
LLM_MODEL_NAME=nanobaseAI
LLM_TIMEOUT_SEC=300
# Eşzamanlı istek sayısı
LLM_PARALLEL=1

# --- Gömme (şema/senaryo arama) modeli — MODELS_DIR/embedding altına indirilir ---
EMBED_HF_REPO=gpustack/bge-m3-GGUF
EMBED_MODEL_FILE=bge-m3-Q8_0.gguf
EMBED_THREADS=4

# --- Tahmin (forecast) servisi ---
# Motor: TimesFM 3.0 (google-research/timesfm, ağırlık google/timesfm-3.0-pytorch, ilk açılışta HF'den /models altına iner).
# Ağırlıkların upstream lisansı ticari olmayan kullanım içindir; FORECAST_ALLOW_NONCOMMERCIAL=1 bu kararı açıkça verir.
# Model indirilemiyorsa/istenmiyorsa FORECAST_ENGINE=seasonal_naive ile modelsiz çalışır.
FORECAST_ENGINE=timesfm3
FORECAST_MODEL3_ID=google/timesfm-3.0-pytorch
FORECAST_ALLOW_NONCOMMERCIAL=1
FORECAST_WITH_TIMESFM=1
FORECAST_THREADS=4
FORECAST_CPUS=4
FORECAST_CHAT_ENABLED=true
FORECAST_HISTORY_MONTHS=36

# --- Query Gateway sınırları ---
QG_MAX_ROWS=1000
QG_STATEMENT_TIMEOUT_S=30

# --- Analitik panel (profil: analytics, isteğe bağlı) ---
ANALYTICS_ENABLED=false
ANALYTICS_PUBLIC_URL=
ANALYTICS_DB_PASSWORD=
ANALYTICS_SECRET_KEY=
ANALYTICS_GUEST_SECRET=
ANALYTICS_ADMIN_USERNAME=nanobaseai-bi-svc
ANALYTICS_ADMIN_PASSWORD=
ANALYTICS_ADMIN_EMAIL=bi@localhost
ANALYTICS_CORS_ORIGINS=http://localhost

# GPU vLLM: son yanıta ayrılan bütçeyi koru.
LLM_EXTRA_BODY_JSON={"chat_template_kwargs":{"enable_thinking":false}}
