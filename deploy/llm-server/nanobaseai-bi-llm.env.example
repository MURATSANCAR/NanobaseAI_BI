# NanobaseAI BI LLM — GPU sunucusu servis ayarları (/etc/nanobaseai/nanobaseai-bi-llm.env)
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8011
MODEL_ALIAS=nanobaseai-bi-llm

# Ağırlıklar: install.sh MODELS_DIR altına indirir
MODEL_FILE=/opt/nanobaseai/models/llm/UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf
DRAFT_FILE=/opt/nanobaseai/models/llm/MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf

# Sabit üretim profili: 24K bağlam, tek akış, MTP-3
CTX_SIZE=24576
PARALLEL=1
MTP_N_MAX=3

# CPU tarafı (MoE expert ağırlıkları RAM'de): çekirdek sayısının ~yarısı
THREADS=32
BATCH=4096
UBATCH=2048
# Kaç MoE katmanının expert'leri CPU'da kalsın: 999 = hepsi (en güvenli).
# Model 48 katman, katman başı ~1.7 GB expert. Ölçülen: A40 46 GB → 26 (≈40 GB VRAM,
# prompt ~300 tok/s, üretim ~23 tok/s, MTP kabul ~%80). 24 GB VRAM → 40, 80 GB → 8.
N_CPU_MOE=26
CACHE_TYPE_K=f16
CACHE_TYPE_V=f16
