# ZEKİ AI web ön kapısı — bizim sunucudaki /timas/ yollarının aynısı (portal.nanobase.ai).
# ${CALLER_TOKEN} ve ${ADMIN_TOKEN} açılışta envsubst ile yazılır; $uri gibi nginx değişkenlerine dokunulmaz.
# Giriş: login konteyneri (Timaş AD). Veri yolları oturum ister; çerez Secure olduğundan dış kapı HTTPS'tir (NPM).
limit_req_zone $binary_remote_addr zone=timas_login:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=timas_ask:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=timas_api:10m rate=120r/m;
limit_req_zone $binary_remote_addr zone=timas_studio_img:10m rate=600r/m;

server {
    listen 80;
    server_name _;
    client_max_body_size 8m;
    # Docker DNS: login/bridge yeniden kurulunca iç adresleri değişir.
    resolver 127.0.0.11 valid=30s ipv6=off;
    # İstekler NPM konteynerinden gelir; hız sınırı kişinin adresine uygulansın, herkes tek kova olmasın.
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Real-IP;

    location = / { return 302 /timas/; }
    location = /timas { return 302 /timas/; }

    # Oturum denetimi: değişiklik yapan isteklerde Origin de bakılır (giriş servisi).
    location = /_timas_session_check {
        internal;
        # Alt istek ana isteğin gövde boyunu kendi konumuna göre de denetler; sunucu düzeyindeki 8m burada
        # 15 MB Word yüklemesini 413 → 500 yapıyordu. Gövde iletilmez; sınırı çağıran konum koyar.
        client_max_body_size 0;
        proxy_pass http://login:8796/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-Method $timas_original_method;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Origin $http_origin;
    }

    location ^~ /timas/auth/ {
        limit_req zone=timas_login burst=10 nodelay;
        limit_req_status 429;
        client_max_body_size 4k;
        proxy_pass http://login:8796/;
        proxy_set_header Origin $http_origin;
        proxy_set_header Cookie $http_cookie;
        proxy_hide_header X-Powered-By;
    }

    location ~ ^/timas/api/v1/ask(_agent)?$ {
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_ask burst=3 nodelay;
        limit_req_status 429;
        rewrite ^/timas(/api/.*)$ $1 break;
        proxy_pass http://bridge:8795;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }

    # Onay kararı kataloğu değiştirir: yönetici anahtarı YALNIZ bu uca eklenir.
    location ~ ^/timas/api/v1/semantic/concepts/[^/]+/review$ {
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_api burst=10 nodelay;
        rewrite ^/timas(/api/.*)$ $1 break;
        proxy_pass http://bridge:8795;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_set_header x-semantic-admin "${ADMIN_TOKEN}";
        proxy_read_timeout 120s;
    }

    # Kitap Tasarım Stüdyosu önizlemeleri: bir açılışta 60+ küçük görsel; genel API sınırına (120/dk) takılmasın.
    location ~ "^/timas/api/v1/editorial/studio/jobs/[0-9a-f]{20}/(pages/[0-9]+/preview|cover/preview|art/[0-9a-z]+/[0-9]+|characters/[0-9]+)$" {
        if ($request_method != GET) { return 405; }
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_studio_img burst=120 nodelay;
        limit_req_status 429;
        rewrite ^/timas/api/(.*)$ /api/$1 break;
        proxy_pass http://bridge:8795;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_read_timeout 120s;
    }

    # Stüdyoya Word yükleme: köprü 20 MB'a kadar kabul eder; genel API gövde sınırı 10 MB.
    location = /timas/api/v1/editorial/studio/jobs/docx {
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_api burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://bridge:8795/api/v1/editorial/studio/jobs/docx;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_read_timeout 120s;
        client_max_body_size 21M;
    }

    # Motor: aynı docker ağındaki bridge konteynerine ada göre.
    location /timas/api/ {
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_api burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://bridge:8795/api/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;          # /api/v1/ask/stream (SSE)
        client_max_body_size 10M;
    }

    # Ana ekran özeti: jobs konteyneri 3 dakikada bir yazar; ekran açılışta sorgu koşturmaz.
    location /timas/metrics/ {
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        alias /usr/share/nginx/metrics/;
        default_type application/json;
        add_header Cache-Control "no-store" always;
    }

    location /timas/assets/ {
        alias /usr/share/nginx/html/assets/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA: HTML önbelleğe alınmaz — yeni sürüm eski hash'li dosyaları siler, eski kopya boş sayfa olur.
    location /timas/ {
        alias /usr/share/nginx/html/;
        add_header Cache-Control "no-store, must-revalidate" always;
        try_files $uri $uri/ /timas/index.html;
    }
}
