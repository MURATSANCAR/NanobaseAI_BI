# ZEKİ AI web ön kapısı — bizim sunucudaki /timas/ yollarının aynısı (portal.nanobase.ai).
# ${CALLER_TOKEN} ve ${ADMIN_TOKEN} açılışta envsubst ile yazılır; $uri gibi nginx değişkenlerine dokunulmaz.
# Giriş: login konteyneri (Timaş AD). Veri yolları oturum ister; çerez Secure olduğundan dış kapı HTTPS'tir (NPM).
limit_req_zone $binary_remote_addr zone=timas_login:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=timas_ask:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=timas_api:10m rate=120r/m;
limit_req_zone $binary_remote_addr zone=timas_studio_img:10m rate=600r/m;
# ZEKİ AI Destek (8446): şifre alan giriş uçları, IP başına dakikada 10 (test sunucusundaki vhost'la aynı).
limit_req_zone $binary_remote_addr zone=destek_login:10m rate=10r/m;

server {
    listen 80;
    server_name _;
    client_max_body_size 8m;
    # Docker DNS: login/bridge yeniden kurulunca iç adresleri değişir.
    resolver 127.0.0.11 valid=30s ipv6=off;
    # İstekler NPM konteynerinden gelir; hız sınırı kişinin adresine uygulansın, herkes tek kova olmasın.
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Real-IP;

    location = / { return 302 /timas/; }
    location = /timas { return 302 /timas/; }

    # Oturum denetimi: değişiklik yapan isteklerde Origin de bakılır (giriş servisi).
    location = /_timas_session_check {
        internal;
        # Alt istek ana isteğin gövde boyunu kendi konumuna göre de denetler; sunucu düzeyindeki 8m burada
        # 15 MB Word yüklemesini 413 → 500 yapıyordu. Gövde iletilmez; sınırı çağıran konum koyar.
        client_max_body_size 0;
        proxy_pass http://login:8796/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-Method $timas_original_method;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Origin $http_origin;
    }

    location ^~ /timas/auth/ {
        limit_req zone=timas_login burst=10 nodelay;
        limit_req_status 429;
        client_max_body_size 4k;
        proxy_pass http://login:8796/;
        proxy_set_header Origin $http_origin;
        proxy_set_header Cookie $http_cookie;
        # Giriş olay kaydının kaynak adresi (M49); giriş servisinin yönetim uçları bu başlığı taşıyan isteği reddeder.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_hide_header X-Powered-By;
    }

    location ~ ^/timas/api/v1/ask(_agent)?$ {
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_ask burst=3 nodelay;
        limit_req_status 429;
        rewrite ^/timas(/api/.*)$ $1 break;
        proxy_pass http://bridge:8795;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }

    # Onay kararı kataloğu değiştirir: yönetici anahtarı YALNIZ bu uca eklenir.
    location ~ ^/timas/api/v1/semantic/concepts/[^/]+/review$ {
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_api burst=10 nodelay;
        rewrite ^/timas(/api/.*)$ $1 break;
        proxy_pass http://bridge:8795;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_set_header x-semantic-admin "${ADMIN_TOKEN}";
        proxy_read_timeout 120s;
    }

    # Kitap Tasarım Stüdyosu önizlemeleri: bir açılışta 60+ küçük görsel; genel API sınırına (120/dk) takılmasın.
    location ~ "^/timas/api/v1/editorial/studio/jobs/[0-9a-f]{20}/(pages/[0-9]+/preview|cover/preview|art/[0-9a-z]+/[0-9]+|characters/[0-9]+)$" {
        if ($request_method != GET) { return 405; }
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_studio_img burst=120 nodelay;
        limit_req_status 429;
        rewrite ^/timas/api/(.*)$ /api/$1 break;
        proxy_pass http://bridge:8795;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_read_timeout 120s;
    }

    # Kapak arşivi görselleri: bir sayfada 60 kapak; genel API sınırına (120/dk) takılmasın.
    location ~ "^/timas/api/v1/editorial/studio/library/covers/[a-z]{2,10}-[A-Za-z0-9_.-]{1,60}/image$" {
        if ($request_method != GET) { return 405; }
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_studio_img burst=120 nodelay;
        limit_req_status 429;
        rewrite ^/timas/api/(.*)$ /api/$1 break;
        proxy_pass http://bridge:8795;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_read_timeout 120s;
    }

    # Stüdyoya Word yükleme: köprü 20 MB'a kadar kabul eder; genel API gövde sınırı 10 MB.
    location = /timas/api/v1/editorial/studio/jobs/docx {
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_api burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://bridge:8795/api/v1/editorial/studio/jobs/docx;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_read_timeout 120s;
        client_max_body_size 21M;
    }

    # Zeki AI sesli not: telefon kaydı (16 kHz WAV, 5 dk ≈ 9,6 MB); köprü VOICE_NOTE_MAX_MB'ı (20) kendisi uygular.
    # Ses nginx'in geçici dosyasına yazılmasın: istek tamponu kapalı, gövde geldikçe köprüye akar.
    location = /timas/api/v1/voice-note {
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_api burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://bridge:8795/api/v1/voice-note$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_request_buffering off;
        proxy_read_timeout 420s;
        client_max_body_size 21M;
    }

    # Kampüs sesli bülteni yükleme: köprü 60 MB'a kadar ses kabul eder (BULLETIN_MAX_MB).
    location = /timas/api/v1/admin/bulletins {
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_api burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://bridge:8795/api/v1/admin/bulletins$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_read_timeout 300s;
        client_max_body_size 61M;
    }

    # Serbest çalışan portfolyo görselleri: liste ve kart bir açılışta onlarca görsel ister.
    location ~ "^/timas/api/v1/editorial/freelance/portfolio/[0-9a-f]{32}$" {
        if ($request_method != GET) { return 405; }
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_studio_img burst=120 nodelay;
        limit_req_status 429;
        rewrite ^/timas/api/(.*)$ /api/$1 break;
        proxy_pass http://bridge:8795;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_read_timeout 120s;
    }

    # Serbest çalışan portfolyo (40 MB) ve teslim (200 MB) yüklemesi; genel API gövde sınırı 10 MB.
    location ~ "^/timas/api/v1/editorial/freelance/(people/[0-9a-f]{32}/portfolio|tasks/[0-9a-f]{32}/delivery)$" {
        if ($request_method != PUT) { return 405; }
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_api burst=30 nodelay;
        limit_req_status 429;
        rewrite ^/timas/api/(.*)$ /api/$1 break;
        proxy_pass http://bridge:8795;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_request_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        client_max_body_size 201M;
    }

    # Stüdyo sesli okuma yüklemeleri: ses kütüphanesine kayıt («Ses yükle») ve kitabın insan kaydı (tam kitap
    # tek dosya olabilir). Köprü 250 MB'a kadar kabul eder (test sunucusu: deploy/nanobase-direct/add-studio-voice-size.py);
    # genel API gövde sınırı 10 MB.
    location ~ "^/timas/api/v1/editorial/studio/(voices|jobs/[0-9a-f]{20}/narration/recordings)$" {
        if ($request_method !~ ^(GET|POST)$) { return 405; }
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_api burst=30 nodelay;
        limit_req_status 429;
        rewrite ^/timas/api/(.*)$ /api/$1 break;
        proxy_pass http://bridge:8795;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_request_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        client_max_body_size 251M;
    }

    # M19 Pazarlama görsel ve metin: varlık önizlemeleri ve dosyaları (talep ekranı ve arşiv bir açılışta onlarca görsel ister).
    location ~ "^/timas/api/v1/marketing/creative/(assets/[0-9a-f]{32}/file|requests/MC-[0-9]{4}-[0-9]{4,}/cover|brand/files/[0-9a-f]{32})$" {
        if ($request_method != GET) { return 405; }
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_studio_img burst=120 nodelay;
        limit_req_status 429;
        rewrite ^/timas/api/(.*)$ /api/$1 break;
        proxy_pass http://bridge:8795;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_read_timeout 120s;
    }

    # M19 kapak (25 MB) ve marka kiti dosyası (20 MB) yüklemesi; genel API gövde sınırı 10 MB.
    location ~ "^/timas/api/v1/marketing/creative/(requests/MC-[0-9]{4}-[0-9]{4,}/cover|brand/files)$" {
        if ($request_method != PUT) { return 405; }
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_api burst=30 nodelay;
        limit_req_status 429;
        rewrite ^/timas/api/(.*)$ /api/$1 break;
        proxy_pass http://bridge:8795;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 26M;
    }

    # Motor: aynı docker ağındaki bridge konteynerine ada göre.
    location /timas/api/ {
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        limit_req zone=timas_api burst=30 nodelay;
        limit_req_status 429;
        proxy_pass http://bridge:8795/api/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;          # /api/v1/ask/stream (SSE)
        client_max_body_size 10M;
    }

    # Ana ekran özeti: jobs konteyneri 3 dakikada bir yazar; ekran açılışta sorgu koşturmaz.
    location /timas/metrics/ {
        set $timas_original_method $request_method;
        auth_request /_timas_session_check;
        alias /usr/share/nginx/metrics/;
        default_type application/json;
        add_header Cache-Control "no-store" always;
    }

    location /timas/assets/ {
        alias /usr/share/nginx/html/assets/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA: HTML önbelleğe alınmaz — yeni sürüm eski hash'li dosyaları siler, eski kopya boş sayfa olur.
    location /timas/ {
        alias /usr/share/nginx/html/;
        add_header Cache-Control "no-store, must-revalidate" always;
        try_files $uri $uri/ /timas/index.html;
    }
}

# ---------------------------------------------------------------------------------------------------------------
# ZEKİ AI Destek (apps/destek) — müşteri VM'inde ön kapı :8446 (HTTP, iç ağ). Destek kapsayıcısı bi_net'e
# `destek-frontend` adıyla bağlanır (apps/destek/docker/compose.bi-net.yaml). Ad istek anında çözülür: Destek kurulu
# değilse yalnız bu port 502 verir, BI etkilenmez. Test sunucusunda bu işi nginx vhost'u yapar
# (apps/destek/deploy/nginx-destek-8446.conf); iki yer aynı kuralları taşır.
server {
    listen 8446;
    server_name _;
    client_max_body_size 50m;
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $destek http://destek-frontend:8080;

    location = / { return 302 /helpdesk; }

    # Şifre alan giriş uçları: hız sınırı.
    location ~ ^/api/method/(login|frappe\.integrations\.doctype\.ldap_settings\.ldap_settings\.login)$ {
        limit_req zone=destek_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass $destek;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Host $http_host;
    }

    # Tek oturum dönüşü: 60 sn'lik tek kullanımlık jeton adreste taşınır; günlüğe yazılmaz.
    location = /api/method/nanobase_brand.sso.login {
        access_log off;
        limit_req zone=destek_login burst=10 nodelay;
        limit_req_status 429;
        proxy_pass $destek;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Host $http_host;
    }

    # Canlı bildirim yalnız bu sitenin sayfalarından: başka site kullanıcının çereziyle bağlanamaz (Destek'in iç
    # sunucusu kaynak adresini kendisi yazar). Aynı kaynaktan GET'te tarayıcı Origin göndermez: boş geçer.
    location /socket.io {
        set $destek_origin_ok 0;
        if ($http_origin = "") { set $destek_origin_ok 1; }
        if ($http_origin = "${DESTEK_PUBLIC_ORIGIN}") { set $destek_origin_ok 1; }
        if ($destek_origin_ok = 0) { return 403; }
        proxy_pass $destek;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }

    location / {
        proxy_pass $destek;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # Yapay zekâ panelinin akışlı yanıtı tamponlanmaz.
        proxy_buffering off;
    }
}

# Destek → Zeki AI modeli ve müşteri bağlamı (M51): yalnız bi_net içinde (8447 dışa açılmaz). Test sunucusundaki
# /destek-llm ve /destek-baglam nginx parçalarının aynısı; anahtar .env DESTEK_LLM_KEY (boşsa 503, kapı kapalı).
server {
    listen 8447;
    server_name _;
    set $destek_llm_key "${DESTEK_LLM_KEY}";

    location ^~ /destek-llm/v1/ {
        if ($destek_llm_key = "") { return 503; }
        if ($http_authorization != "Bearer ${DESTEK_LLM_KEY}") { return 401; }
        proxy_pass http://bridge:8795/api/v1/llm/openai/v1/;
        proxy_http_version 1.1;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header X-LLM-Module "destek";
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 32m;
    }

    location ^~ /destek-baglam/v1/ {
        if ($destek_llm_key = "") { return 503; }
        if ($http_authorization != "Bearer ${DESTEK_LLM_KEY}") { return 401; }
        limit_except GET POST { deny all; }
        proxy_pass http://bridge:8795/api/v1/support/panel/;
        proxy_http_version 1.1;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header x-semantic-caller "${CALLER_TOKEN}";
        proxy_read_timeout 180s;
        client_max_body_size 1m;
    }
}
