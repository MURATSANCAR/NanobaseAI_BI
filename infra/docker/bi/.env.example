# Gerçek .env bu örnekten türetilir; secrets/ ve .env commit EDİLMEZ (bkz .gitignore).
# Sırlar (PG_PASSWORD, tokenlar, SQL parolası) kurulumda doldurulur.

PG_PASSWORD=degistir
SEMANTIC_CALLER_TOKEN=degistir
SEMANTIC_ADMIN_TOKEN=degistir

# Tarayıcının açtığı adres (giriş servisi Origin denetimi). Giriş çerezi Secure: HTTPS olmalı.
PORTAL_ORIGIN=https://192.168.0.55

SEMANTIC_TENANT_ID=default
SEMANTIC_DATASOURCE_ID=logo
SEMANTIC_SCHEMA=dbo
SEMANTIC_DIALECT=
SEMANTIC_MIN_SUPPORT=3
SEMANTIC_SUMMARY_MODE=fast
SEMANTIC_QUERY_TIMEOUT_SEC=45
SEMANTIC_EXCLUDE_CONTEXT=015,016

# LLM: şimdilik NVIDIA hosted deepseek-v4-flash (OpenAI uyumlu). Müşteri kendi ucunu isterse bu üç satır değişir.
# Anahtarı buraya YAZMA; kurulumda gerçek .env'e NVIDIA API anahtarını koy.
OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
LLM_MODEL_NAME=deepseek-ai/deepseek-v4-flash-0731
LLM_TIMEOUT_SEC=240
LLM_CTX=16384

# Vektör router + tablo seçici de LLM/embed'e bağlı — uç gelene kadar kapalı.
SEMANTIC_RECALL=0
QDRANT_URL=
SEMANTIC_TABLE_SELECTOR=off

# Uyarı e-postası: gönderici hesap tanımlanınca doldurulur. Boşken kurallar yine kontrol edilir,
# eşik aşılınca ekranda görünür; hesap gelince bekleyen uyarılar gönderilir.
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
ALERT_LINK=
