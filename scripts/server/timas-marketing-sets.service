[Unit]
Description=Set, hediye ve promosyon (M53): CRM/Logo okuması, set önerileri, uyarılar; pazar günü B2C birlikte alım ve geçmiş yıllar
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/marketing/sets/run-due); bu birim yalnız çağırır. Birlikte alım sorgusu (B2C, 24 ay) ve geçmiş
# yılların satışı pazar günü okunur; ilk kurulumda elle koşturulup süresi ölçülür (günlüğe yazılır).
ExecStart=/bin/sh -c 'curl -fsS -m 3590 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" http://127.0.0.1:8795/api/v1/marketing/sets/run-due'
