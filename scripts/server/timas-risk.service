[Unit]
Description=Risk ve uyum (M47): göstergeleri ölçer, kırmızı kenarında ve hatırlatmalarda bildirir, uyum takvimini açar
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/risk/run-due); bu birim yalnız çağırır. Özet RISK_ALERT_RECIPIENTS'e, kritik riske bağlı
# kırmızı RISK_CRITICAL_RECIPIENTS'e, kayıtlarda e-postası olan sahiplere kendi maddeleri gider. Logo/CRM'e yazma yok.
# İlk kez elle koşturulur: systemctl start timas-risk.service (bellek: run-it-before-it-runs-itself).
ExecStart=/bin/sh -c 'curl -fsS -m 3590 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" http://127.0.0.1:8795/api/v1/risk/run-due'
