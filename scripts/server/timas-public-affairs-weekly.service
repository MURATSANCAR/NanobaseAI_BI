[Unit]
Description=Kurumsal ilişkiler (M28): temas zamanı gelen kişiler, geciken proje adımları, onay bekleyen hediyeler (iç alıcılara)
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Alıcı REL_ALERT_RECIPIENTS (iç adresler); boşsa e-posta gitmez. Kişilere ve kurumlara hiçbir e-posta gitmez.
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 900 -X POST "http://127.0.0.1:8795/api/v1/public-affairs/run-due?weekly=1"
