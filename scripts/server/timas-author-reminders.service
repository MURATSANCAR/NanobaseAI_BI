[Unit]
Description=Yazar ilişkileri: kişi başına sabah e-posta özeti (randevu, notu eksik randevu, geciken adım)
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/editorial/authors/reminders/run-due); birim yalnız çağırır. Kişi × gün bir kez gönderilir,
# yeniden çalışması zararsızdır. $$ ile anahtar kabuktan okunur, günlüğe düşmez.
TimeoutStartSec=15min
ExecStart=/bin/sh -c 'curl -fsS -m 800 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" "http://127.0.0.1:8795/api/v1/editorial/authors/reminders/run-due"'
