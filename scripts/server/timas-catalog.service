[Unit]
Description=Katalog ve bülten (M24): kitap havuzunu yeniler, açık katalogların fiyat/stok/satış durumu uyarılarını yazar, CRM'e bağlı bültenlerin sonucunu okur
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/catalog-newsletter/run-due); bu birim yalnız çağırır. Kritik uyarı ve onay bekleyenler tek özet
# e-postayla iç ekibe (CATALOG_ALERT_RECIPIENTS) gider; okura ya da bayiye hiçbir gönderim yok, toplu e-posta yok.
# İlk kez elle koşturulur: systemctl start timas-catalog.service (bellek: run-it-before-it-runs-itself).
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 1790 -X POST "http://127.0.0.1:8795/api/v1/catalog-newsletter/run-due"
