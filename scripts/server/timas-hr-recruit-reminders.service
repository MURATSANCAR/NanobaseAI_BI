[Unit]
Description=İşe alım (M55): aşamasında eşik günden uzun bekleyen adaylar için İK alıcılarına tek özet e-posta (aday bilgisi yok)
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/hr/recruit/reminders/run-due). HR_RECRUIT_SLA_DAYS ya da HR_ALERT_RECIPIENTS yoksa gönderim yok.
# Adaya hiçbir şey gönderilmez. İlk kez elle koşturulur: systemctl start timas-hr-recruit-reminders.service
ExecStart=/bin/sh -c 'curl -fsS -m 290 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" http://127.0.0.1:8795/api/v1/hr/recruit/reminders/run-due'
