[Unit]
Description=Sistem durumu (M48): halka denetimi, olay aç/kapat, iç alıcılara bildirim, zamanlanmış iş toplayıcı
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/it-ops/run-due); bu birim yalnız çağırır. Denetimler yalnız okur, hiçbir servisi yeniden başlatmaz.
# Model halkası sırada bekleyebilir (en çok ITOPS_MODEL_TIMEOUT_SEC); tur 5 dk'yı geçmesin diye 290 sn.
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 290 -X POST "http://127.0.0.1:8795/api/v1/it-ops/run-due"
