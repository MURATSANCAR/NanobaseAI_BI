[Unit]
Description=Müşteri hizmetleri (M51) gece turu: SSS dizini ve bilgi bankası açığı listesi
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/support/run-due). İlk kez elle: systemctl start timas-support-gece.service
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 1700 -X POST "http://127.0.0.1:8795/api/v1/support/run-due"
