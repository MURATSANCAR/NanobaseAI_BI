[Unit]
Description=Kurumsal satış ve B2B (M32): haftalık sipariş vermeyen bayi özeti (iç alıcılara)
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Okuma yeniden yapılır, model işi yapılmaz. Alıcı CORP_B2B_REPORT_TO (iç adresler); boşsa e-posta gitmez.
ExecStart=/bin/sh -c 'curl -fsS -m 1790 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" "http://127.0.0.1:8795/api/v1/corporate/run-due?weekly=1&model=0"'
