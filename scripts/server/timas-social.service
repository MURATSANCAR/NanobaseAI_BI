[Unit]
Description=Sosyal medya (M22): günlük özet (yarın hazır olmayan gönderi, yaklaşan özel gün, onay bekleyen) ve tür etiketi
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/social/run-due); bu birim yalnız çağırır. Hiçbir sosyal medya hesabına paylaşım yapılmaz.
# İlk kurulumda elle bir kez koşturulur:
#   systemctl start timas-social.service && journalctl -u timas-social.service -n 50
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 1790 -X POST "http://127.0.0.1:8795/api/v1/social/run-due"
