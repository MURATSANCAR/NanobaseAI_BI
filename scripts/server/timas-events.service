[Unit]
Description=Fuar, etkinlik ve ödül (M27): geri sayım, geciken görev, ödül son tarihi, stok uyarısı; biten fuarın sonuç ön hesabı
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/events/run-due); bu birim yalnız çağırır. Dış gönderim yok: hatırlatmalar ekranda ve Kampüs
# ajandasında. İlk kez elle koşturulur:
#   systemctl start timas-events.service && journalctl -u timas-events -n 50
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 1800 -X POST "http://127.0.0.1:8795/api/v1/events/run-due"
