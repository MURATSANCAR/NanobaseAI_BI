[Unit]
Description=M7 çapraz yazar önerisi: T-soft siparişlerinden birlikte alınan yazarlar (yalnız okuma)
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/editorial/authors/copurchase/run-due); tur köprüde arka planda sürer.
# T-soft bağlantısı tanımlı olmayan ortamda uç «atlandı» döner. $$ ile anahtar kabuktan okunur, günlüğe düşmez.
TimeoutStartSec=5min
ExecStart=/bin/sh -c 'curl -fsS -m 120 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" "http://127.0.0.1:8795/api/v1/editorial/authors/copurchase/run-due"'
