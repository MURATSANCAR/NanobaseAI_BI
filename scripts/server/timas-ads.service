[Unit]
Description=Reklam (M21): Logo e-ticaret cirosu ve stok önbelleği, kampanya ↔ kitap önerisi, öneri kuralları
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/ads/run-due); bu birim yalnız çağırır. Reklam platformlarına hiçbir şey gönderilmez.
# İlk kurulumda elle bir kez koşturulur:
#   systemctl start timas-ads.service && journalctl -u timas-ads.service -n 50
ExecStart=/bin/sh -c 'curl -fsS -m 3590 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" http://127.0.0.1:8795/api/v1/ads/run-due'
