[Unit]
Description=İK gece imha işi (İK-0): saklama süresi dolan aday/İK verisini siler, veri sınıfı başına tutanak yazar
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/hr/purge/run-due); bu birim yalnız çağırır. Süre girilmemiş sınıfta hiçbir şey silinmez.
# İlk kez elle koşturulur: systemctl start timas-hr-purge.service (bellek: run-it-before-it-runs-itself).
ExecStart=/bin/sh -c 'curl -fsS -m 1790 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" http://127.0.0.1:8795/api/v1/hr/purge/run-due'
