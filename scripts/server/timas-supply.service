[Unit]
Description=Tedarik ve baskı (M52): yük dengeleme ve kağıt önerisi, fatura ↔ kart adayları, eşik aşımı özeti
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/supply/run-due); bu birim yalnız çağırır. Eşik aşımı iç ekibe (SUPPLY_ALERT_RECIPIENTS) tek
# özetle gider; matbaaya, CRM'e, Logo'ya gönderim/yazma yok. Model arka plan önceliğiyle LLM kapısından.
# İlk kez elle koşturulur: systemctl start timas-supply.service (bellek: run-it-before-it-runs-itself).
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 1790 -X POST "http://127.0.0.1:8795/api/v1/supply/run-due"
