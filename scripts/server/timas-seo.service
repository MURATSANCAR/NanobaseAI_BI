[Unit]
Description=SEO & GEO: T-soft ürün eşitlemesi ve denetimi, Search Console okuması
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/seo-geo/run-due); birim yalnız çağırır. T-soft eşitlemesi köprüde arka planda sürer,
# bağlantısı tanımlı olmayan kaynak atlanır. $$ ile anahtar kabuktan okunur, günlüğe düşmez.
# +15 dk: köprü yeniden başlarken kopru-cagir.sh hazır olmasını bekler (KOPRU_BEKLE_SN)
TimeoutStartSec=45min
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 1700 -X POST "http://127.0.0.1:8795/api/v1/seo-geo/run-due"
