[Unit]
Description=Pazarlama (M15): yeni kitap planı günlük hatırlatma özeti ve karne tazeleme
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/marketing/run-due); bu birim yalnız çağırır. İlk kurulumda elle bir kez koşturulur:
#   systemctl start timas-marketing.service && journalctl -u timas-marketing.service -n 50
ExecStart=/bin/sh -c 'curl -fsS -m 1790 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" http://127.0.0.1:8795/api/v1/marketing/run-due'
