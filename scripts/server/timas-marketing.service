[Unit]
Description=Pazarlama (M15 + M18): yeni kitap hatırlatması, karne tazeleme, ay planı taslağı (15'i), föy CRM denetimi ve hatırlatmaları
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/marketing/run-due); bu birim yalnız çağırır. İlk kurulumda elle bir kez koşturulur:
#   systemctl start timas-marketing.service && journalctl -u timas-marketing.service -n 50
# M18'in günlük işi aynı çağrıda koşar (ayrı birim yok): ayın 15'inde gelecek ayın taslak planı, her gün bu ve gelecek
# ayın föylerinin CRM denetimi, 20'sinde föy hatırlatması, ay başı + 3 iş günü önceki ay özeti, pazartesi sapma özeti.
ExecStart=/bin/sh -c 'curl -fsS -m 1790 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" http://127.0.0.1:8795/api/v1/marketing/run-due'
