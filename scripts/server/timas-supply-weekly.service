[Unit]
Description=Tedarik ve baskı (M52): önümüzdeki 30 günün matbaa ve kağıtçı ödeme listesi (FIFO yaklaşımı)
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Liste iç ekibe (SUPPLY_PAYMENT_RECIPIENTS) e-postayla gider; ödeme yapılmaz, Logo'ya yazılmaz.
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 1790 -X POST "http://127.0.0.1:8795/api/v1/supply/run-due?haftalik=1"
