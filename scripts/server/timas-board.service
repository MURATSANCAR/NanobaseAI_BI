[Unit]
Description=Panolar: zamanı gelen kartları tazele (saatlik / her gün HH:MM)
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/board/run-due); bu birim yalnız çağırır. $$ ile anahtar kabuktan okunur, günlüğe düşmez.
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 590 -X POST "http://127.0.0.1:8795/api/v1/board/run-due"
