[Unit]
Description=Telif dönemi (M54): «koşu açılmadı» hatırlatması, bitişe 90/60/30 gün kalan kararsız sözleşmeler (iç ekibe özet)
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/royalty/run-due); bu birim yalnız çağırır. Koşunun hesabı zamanlayıcıyla başlamaz (ilk sürüm).
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 600 -X POST "http://127.0.0.1:8795/api/v1/royalty/run-due"
