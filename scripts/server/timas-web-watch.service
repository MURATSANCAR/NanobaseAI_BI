[Unit]
Description=Basın ve web: RSS akışları + Wikidata, yazar/kitap eşleme ve yerel model etiketi
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/editorial/web/run-due); birim yalnız çağırır. Bütçe 16200 sn (4,5 saat): Wikidata
# yazar taraması kaldığı yerden sürer, bitmeyen iş sonraki geceye kalır. $$ ile anahtar kabuktan okunur, günlüğe düşmez.
# +15 dk: köprü yeniden başlarken kopru-cagir.sh hazır olmasını bekler (KOPRU_BEKLE_SN)
TimeoutStartSec=5h 15min
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 17000 -X POST "http://127.0.0.1:8795/api/v1/editorial/web/run-due?budget=16200"
