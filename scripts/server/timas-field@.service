[Unit]
Description=Saha satış ve tahsilat (M30): %i turu (gece = portföy + sinyal + özet, hafif = CRM bildirimi, haftalik = rapor)
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/field/run-due?tur=%i); bu birim yalnız çağırır. $$ ile anahtar kabuktan okunur, günlüğe düşmez.
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 1790 -X POST "http://127.0.0.1:8795/api/v1/field/run-due?tur=%i"
