[Unit]
Description=Editör CRM bağlayıcısı: kitapların yayınevi kaydı (yazar, özet, okur kitlesi, yaş, tür) ve kapağı
After=network-online.target nanobase-semantic-bridge.service
# Başarısız koşu (çoğu kez TİMAŞ VPN'i gece düşmüş: CRM .28'e «No route to host», 2026-10-04 03:10) saatte bir yeniden
# denenir, en çok 6 kez (03:10 → 09:10): VPN sabah açılınca o günün koşusu kendiliğinden tamamlanır. 8 saatlik pencere
# ertesi geceye taşmaz.
StartLimitIntervalSec=8h
StartLimitBurst=7

[Service]
Type=oneshot
# EDITOR_CATALOG_BASE / EDITOR_CATALOG_KEY köprünün ortamından: kart servisi TT GPU'dan gelen tünelle 127.0.0.1'de.
EnvironmentFile=/etc/nanobase/semantic-bridge.env
Environment=CRM_CONNECTION_JSON=/data/nanobaseai/bi/secrets/crm-mssql-connection.json
Environment=PYTHONDONTWRITEBYTECODE=1
# CRM'e salt okuma; editöre kitap başına bir eşleşme yazar. Kaynak: apps/editor/connectors/crm_covers.py (main).
ExecStart=/data/nanobaseai/bi/semantic-venv/bin/python /data/nanobaseai/bi/connectors/crm_covers.py
# 4.044 kitapta bir koşu ~50 dk (kitap başına CRM kaydı + kapak + editöre yazım); 30 dk sınırı her gece
# kitapların ~%40'ını aranmadan bırakıyordu (2026-10-03 ölçüm: 2.417/4.044'te kesildi).
TimeoutStartSec=3h
Restart=on-failure
RestartSec=1h
