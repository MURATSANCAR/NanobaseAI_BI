[Unit]
Description=Kurumsal ilişkiler (M28): hediye satırlarının CRM tanıtım siparişi durumu (sevk tarihi → «sevk edildi»)
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/public-affairs/run-due); bu birim yalnız çağırır. CRM yalnız okunur, hiçbir yere gönderim yok.
ExecStart=/bin/sh -c 'curl -fsS -m 900 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" http://127.0.0.1:8795/api/v1/public-affairs/run-due'
