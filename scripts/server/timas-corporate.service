[Unit]
Description=Kurumsal satış ve B2B (M32): Logo/CRM okuması, dönemsel hatırlatma, sessiz bayi listesi, ZEKİ AI önerileri
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/corporate/run-due); bu birim yalnız çağırır. Okuma + model önerileri (CORP_LLM_BUDGET_SEC) sürer.
# Dış gönderim yok: hiçbir kuruma ya da siteye bir şey gitmez.
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 3500 -X POST "http://127.0.0.1:8795/api/v1/corporate/run-due"
