[Unit]
Description=Pazarlama (M16): lansman izleme — CRM sipariş sinyali saatte bir; günde bir Logo satış/depo, D+7/D+30 raporu, özet
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/marketing/launches/run-due); bu birim yalnız çağırır. Günlük kısım
# MARKETING_LAUNCH_DAILY_HOUR (varsayılan 07) sonrasındaki ilk koşuda bir kez yapılır. İlk kurulumda elle bir kez:
#   systemctl start timas-marketing-launch.service && journalctl -u timas-marketing-launch.service -n 50
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 3500 -X POST "http://127.0.0.1:8795/api/v1/marketing/launches/run-due"
