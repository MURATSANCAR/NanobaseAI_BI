[Unit]
Description=Okur topluluğu (M37): envanter ve izin anlık görüntüsü, segment büyüklüğü, süre dolumu, ilgi alanı çağrışım sınıflaması, cevapsız yorum ve yaklaşan program özeti
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/okur/run-due); bu birim yalnız çağırır. Yalnız sayı işlenir; özet e-posta iç ekibe
# (OKUR_ALERT_RECIPIENTS) gider, okura hiçbir ileti gitmez. İlk kez elle koşturulur:
#   systemctl start timas-okur.service && journalctl -u timas-okur.service -n 50
ExecStart=/bin/sh -c 'curl -fsS -m 1790 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" http://127.0.0.1:8795/api/v1/okur/run-due'
