[Unit]
Description=Timas portal session adapter
After=network.target

[Service]
User=www-data
Group=www-data
# venv carries ldap3 + pycryptodome (requirements.txt) for Active Directory sign-in
# LOGIN_ADMIN_TOKEN (M49 güvenlik ekranı; köprünün ortam dosyasındakiyle aynı, en az 24 karakter). Dosya yoksa yönetim
# uçları kapalı kalır, giriş olayları yine yazılır.
EnvironmentFile=-/etc/nanobase/timas-login.env
ExecStart=/opt/timas-login/venv/bin/python /opt/timas-login/server.py
Restart=on-failure
StateDirectory=timas-login
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/timas-login

[Install]
WantedBy=multi-user.target
