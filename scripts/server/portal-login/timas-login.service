[Unit]
Description=Timas portal session adapter
After=network.target

[Service]
User=www-data
Group=www-data
# venv carries ldap3 + pycryptodome (requirements.txt) for Active Directory sign-in
ExecStart=/opt/timas-login/venv/bin/python /opt/timas-login/server.py
Restart=on-failure
StateDirectory=timas-login
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/timas-login

[Install]
WantedBy=multi-user.target
