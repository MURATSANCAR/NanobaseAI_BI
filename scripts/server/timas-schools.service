[Unit]
Description=Okul tanıtım (M31): CRM ziyaret yerleri/etkinlik kopyası, öncelik puanı, ad eşleştirme, bayi önerisi
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/schools/run-due); bu birim yalnız çağırır. İlk kez elle koşturulur:
#   systemctl start timas-schools.service && journalctl -u timas-schools -n 50
ExecStart=/bin/sh -c 'curl -fsS -m 3500 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" "http://127.0.0.1:8795/api/v1/schools/run-due?kind=nightly"'
