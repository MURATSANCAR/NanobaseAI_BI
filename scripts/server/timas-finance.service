[Unit]
Description=Finansal raporlar (M45): bayat yılları Logo'dan oku, pazartesi 07:00 sonrası 13 haftalık nakit tablosunu kur, vergi hatırlatması ve iş günü sabah özeti gönder
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/finance/run-due); bu birim yalnız çağırır. İlk koşu elle yapılır (systemctl start timas-finance.service).
ExecStart=/bin/sh -c 'curl -fsS -m 1790 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" http://127.0.0.1:8795/api/v1/finance/run-due'
