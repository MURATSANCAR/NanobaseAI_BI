[Unit]
Description=Lojistik ve kargo (M44): günlük hata sınıflaması ve iç özet, haftalık firma karnesi, aylık mutabakat özeti
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/shipping/run-due); bu birim yalnız çağırır. Köprü işleri kendisi zamanlar (SHIPPING_DAILY_AT,
# SHIPPING_WEEKLY_AT, ayın 3'ü) ve her birini günde/haftada/ayda bir kez koşar. Kargo firmasına, CRM'e ve müşteriye hiçbir
# şey gönderilmez; e-posta yalnız yönetim ekranındaki iç alıcılara. İlk kurulumda elle: ?gorev=gunluk
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 1790 -X POST "http://127.0.0.1:8795/api/v1/shipping/run-due"
