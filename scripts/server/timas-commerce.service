[Unit]
Description=E-ticaret müşteri (H3): T-soft sipariş/üye okuması, müşteri tablosu ve RFM, ürün görüntülenme farkı, kampanya sonucu, sabah özeti
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/commerce/run-due); bu birim yalnız çağırır. Günde bir okuma (pazar tam tur), 07:00'dan sonraki
# çağrıda iç alıcılara sabah özeti (COMMERCE_SUMMARY_RECIPIENTS). T-soft yalnız okunur; hiçbir sisteme yazılmaz. H2 okur
# turu (03:20) site müşterilerini bu turun yazdığı tablodan okur. İlk kez elle koşturulur: systemctl start timas-commerce.service
ExecStart=/bin/sh -c 'curl -fsS -m 3590 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" http://127.0.0.1:8795/api/v1/commerce/run-due'
