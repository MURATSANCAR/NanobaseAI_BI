[Unit]
Description=Pazar — dağıtımcı ve perakende katalogları: güncel Başarı ve D&R görüntüsü, Logo barkod eşleşmesi, TİMAŞ markası, kalibrasyon
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/pazar/dagitim/run-due); bu birim yalnız çağırır. Kaynak (API_URUN_DB) yalnız okunur.
# İlk kez elle koşturulur: systemctl start timas-pazar-dagitim.service (bellek: run-it-before-it-runs-itself).
ExecStart=/bin/sh -c 'curl -fsS -m 7190 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" http://127.0.0.1:8795/api/v1/pazar/dagitim/run-due'
