[Unit]
Description=Yönetici AD grubunun üyelerini tazele (DB anlık görüntüsü)
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
ExecStart=/bin/sh -c 'curl -fsS -m 60 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" http://127.0.0.1:8795/api/v1/admin/group/refresh'
