[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 60 -X POST "http://127.0.0.1:8795/api/v1/admin/group/refresh"
