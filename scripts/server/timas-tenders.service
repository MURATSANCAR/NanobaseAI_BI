[Unit]
Description=İhale takibi (M33): son teklif, belge geçerliliği, teminat iadesi ve onay bekleyen karar hatırlatmaları; kamu satış özeti
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/tenders/run-due); bu birim yalnız çağırır. Hatırlatma tek özet e-postayla iç ekibe
# (TENDER_ALERT_RECIPIENTS) gider, kuruma gönderim yok. İlan içe alma yalnız TENDER_WATCH_ENABLED=1 ile (ikinci sürüm).
# İlk kez elle koşturulur: systemctl start timas-tenders.service (bellek: run-it-before-it-runs-itself).
ExecStart=/bin/sh -c 'curl -fsS -m 1790 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" http://127.0.0.1:8795/api/v1/tenders/run-due'
