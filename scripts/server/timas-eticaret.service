[Unit]
Description=E-ticaret (M34): site ↔ CRM ↔ Logo fark raporu, Zeki AI neden önerisi, fark bildirimi ve haftalık özet
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/eticaret/run-due); bu birim yalnız çağırır. Site verisi T-soft'tan değil, SEO & GEO eşitlemesinin
# (timas-seo.timer, 03:00) yazdığı tablodan okunur; bu yüzden 04:30'da koşar. Hiçbir sisteme yazılmaz; e-posta yalnız iç
# alıcılara (ECOM_ALERT_RECIPIENTS, ECOM_WEEKLY_TO). İlk kez elle koşturulur: systemctl start timas-eticaret.service
ExecStart=/bin/sh -c 'curl -fsS -m 3590 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" http://127.0.0.1:8795/api/v1/eticaret/run-due'
