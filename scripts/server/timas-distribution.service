[Unit]
Description=İlk dağılım (M29): depoya girişleri oku, izlenen planların takibini tazele, uyarıları değerlendir
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/distribution/run-due); bu birim yalnız çağırır. Üretim kartı okuması ~20 sn, Logo 1-2 dk.
# İlk kez elle koşturulur: systemctl start timas-distribution.service (bellek: run-it-before-it-runs-itself).
ExecStart=/bin/sh -c 'curl -fsS -m 1790 -X POST -H "X-Semantic-Caller: $${SEMANTIC_CALLER_TOKEN}" http://127.0.0.1:8795/api/v1/distribution/run-due'
