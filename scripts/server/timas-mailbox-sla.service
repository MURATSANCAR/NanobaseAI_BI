[Unit]
Description=Kurumsal e-posta (H4): iş saatleriyle SLA, hatırlatma ve eskalasyon (iç bildirim), kutu bağlantı uyarısı
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Alıcılar portal çalışanlarıdır (yönlendirme tablosu, MAIL_INBOX_OWNERS, MAIL_TOP_MANAGERS); gönderene bir şey gitmez.
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 600 -X POST "http://127.0.0.1:8795/api/v1/mailbox/sla-due"
