[Unit]
Description=Eğitim ve gelişim (M57) sabah özeti: dolmuş/dolacak zorunlu eğitim, yarınki oturumlar, onay ve doğrulama bekleyenler
After=nanobase-semantic-bridge.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nanobase/semantic-bridge.env
# Mantık köprüde (/api/v1/hr/learning/reminders/run-due); bu birim yalnız çağırır. Özet yalnız HR_ALERT_RECIPIENTS'a gider
# ve kişi adı içermez; alıcı yoksa hiçbir şey gönderilmez.
# İlk kez elle koşturulur: systemctl start timas-hr-learning.service (bellek: run-it-before-it-runs-itself).
ExecStart=/data/nanobaseai/bi/frontend/scripts/server/kopru-cagir.sh -m 590 -X POST "http://127.0.0.1:8795/api/v1/hr/learning/reminders/run-due"
