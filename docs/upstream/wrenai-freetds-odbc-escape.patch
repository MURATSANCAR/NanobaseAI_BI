+# ---------------------------------------------------------------------------
+# 6. ODBC value escaping: brace only when required (FreeTDS compatibility)
+# ---------------------------------------------------------------------------
+
+
+def _raw_conn_str(connect_call) -> str:
+    (conn_str,), _ = connect_call
+    return conn_str
+
+
+def test_plain_values_are_not_braced() -> None:
+    """FreeTDS rejects ``TDS_Version={7.4}`` / ``ClientCharset={UTF-8}`` (HY001)."""
+    fake = _FakePyodbc()
+    with patch("wren.connector.mssql.pyodbc", fake):
+        _connect_mssql_pyodbc(
+            host="127.0.0.1",
+            port="1433",
+            database="master",
+            user="sa",
+            password="plain",
+            driver="FreeTDS",
+            kwargs={"TDS_Version": "7.4", "ClientCharset": "UTF-8"},
+        )
+    raw = _raw_conn_str(fake.connect.call_args)
+    assert "DRIVER=FreeTDS;" in raw
+    assert "DATABASE=master;" in raw
+    assert "UID=sa;" in raw
+    assert "PWD=plain;" in raw
+    assert "TDS_Version=7.4" in raw
+    assert "ClientCharset=UTF-8" in raw
+
+
+def test_values_needing_quotes_are_braced() -> None:
+    fake = _FakePyodbc()
+    with patch("wren.connector.mssql.pyodbc", fake):
+        _connect_mssql_pyodbc(
+            host="127.0.0.1",
+            port="1433",
+            database="my db",
+            user="dom\\user",
+            password="p;w}d",
+            driver="ODBC Driver 18 for SQL Server",
+            kwargs=None,
+        )
+    raw = _raw_conn_str(fake.connect.call_args)
+    assert "DATABASE={my db};" not in raw  # inner spaces do not need quoting
+    assert "DATABASE=my db;" in raw
+    assert "PWD={p;w}}d}" in raw  # ';' forces braces, '}' is doubled
+    parts = _parse_conn_str(fake.connect.call_args)
+    assert parts["PWD"] == "p;w}d"
+    assert parts["UID"] == "dom\\user"
