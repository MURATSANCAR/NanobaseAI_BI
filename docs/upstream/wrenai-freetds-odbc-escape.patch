 def _escape_odbc_value(value: str) -> str:
-    return "{" + value.replace("}", "}}") + "}"
+    """Quote an ODBC connection-string value only when it needs it.
+
+    Braces are the ODBC escape for values containing ``;``, ``{``/``}`` or
+    leading/trailing whitespace. Microsoft's driver strips braces from every
+    attribute, but FreeTDS only does so for the attributes it expects quoted
+    (DRIVER, DATABASE, UID, PWD); ``TDS_Version={7.4}`` or
+    ``ClientCharset={UTF-8}`` make it fail SQLDriverConnect with
+    ``HY001 Memory allocation failure``. Bracing only when required keeps
+    both drivers working.
+    """
+    if not value:
+        return value
+    if value.startswith("{") or any(ch in value for ch in ";{}") or value != value.strip():
+        return "{" + value.replace("}", "}}") + "}"
+    return value
 
 
