let
    Kaynak = Sql.Database("192.168.0.28", "Timas_MSCRM", [Query="#(lf)SELECT sm5.Value as Oncelik,S.new_name AS Sip_No,S.new_siparistarihi As SipTarihi, LEFT(S.new_name, 3) AS Kanal,#(lf)C.new_CariKodu AS CariKod, C.Name AS Firma,  sm2.Value AS Durum, #(lf)sm3.Value AS SiparişTipi, P.ProductNumber AS StokKodu, #(lf)SS.new_urunidName AS Ürün_Adı, K.new_yayineviidName AS Yayinevi, K.new_yazartext AS Yazar, #(lf)SS.new_adet AS Sip_Adet, #(lf) SS.new_indirimlitoplamtutar AS NetTutar,S.new_iparaorderid as IparaId  FROM #(lf)#(tab)dbo.new_siparis AS S LEFT OUTER JOIN #(lf)#(tab)dbo.new_siparissatiri AS SS ON SS.new_siparisid = S.new_siparisId LEFT OUTER JOIN #(lf)#(tab)dbo.Account AS C ON S.new_firmaid = C.AccountId LEFT OUTER JOIN dbo.Product AS P ON SS.new_urunid = P.ProductId LEFT OUTER JOIN #(lf)#(tab)dbo.StringMap AS sm2 ON sm2.ObjectTypeCode = 10285 AND sm2.LangId = 1055 AND sm2.AttributeName = 'statuscode' AND sm2.AttributeValue = S.statuscode LEFT OUTER JOIN #(lf)#(tab)dbo.StringMap AS sm3 ON sm3.ObjectTypeCode = 10285 AND sm3.LangId = 1055 AND sm3.AttributeName = 'new_Siparistipi' AND sm3.AttributeValue = S.new_siparistipi LEFT OUTER JOIN  #(lf)#(tab)dbo.StringMap AS sm5 ON sm5.ObjectTypeCode = 10285 AND sm5.LangId = 1055 AND sm5.AttributeName = 'new_siparisoncelikdurumu' AND sm5.AttributeValue = S.new_siparisoncelikdurumu LEFT OUTER JOIN #(lf)#(tab)dbo.new_kitap AS K ON K.new_StokKodu = P.ProductNumber where sm2.Value not in ('Birleştirildi','Sevk Edildi','Tamamlandı','Etkin değil','İptal Edildi','Taslak') #(lf)#(tab)and LEFT(S.new_name, 3) not in ('B2C') and S.new_siparistarihi is not null and C.new_CariKodu not in ('32001.01.PA099','12001.01.C10340')"])
in
    Kaynak
