# DB-GPT + Nanobase LLM (from MobilTest docs/LLM-SERVER.md)

DBGPT_LANG=en
DBGPT_HOST=0.0.0.0
DBGPT_PORT=5670
DBGPT_ENCRYPT_KEY=nanobase-dbgpt-local-key

# Prefer local llama.cpp; on laptop without LLM use the public proxy (IP-whitelisted).
# Local (on NanobaseAI server):  http://127.0.0.1:8010/v1
# Remote proxy:                  http://38.247.162.28:8015/v1
OPENAI_API_BASE=http://127.0.0.1:8010/v1
OPENAI_API_KEY=nanobase-local
LLM_MODEL_NAME=nanobase-qwen36-35b-a3b-mtp
LLM_MODEL_PROVIDER=proxy/openai

# SQL planning: prefer lighter Arctic Text2SQL; fall back to chat model under failure
TEXT2SQL_API_BASE=http://127.0.0.1:8091/v1
TEXT2SQL_MODEL=arctic-text2sql
TEXT2SQL_FALLBACK_TO_CHAT=1
TEXT2SQL_TIMEOUT_SEC=60
LLM_TIMEOUT_SEC=90
LLM_HEALTH_TIMEOUT_SEC=3

# Embeddings via bridge OpenAI shim → BGE-M3 contract service
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_PROVIDER=proxy/openai
EMBEDDING_MODEL_API_URL=http://127.0.0.1:8789/v1/embeddings
EMBEDDING_API_KEY=nanobase-local
BI_EMBED_URL=http://127.0.0.1:8083/v1/embeddings
BI_EMBED_API_KEY=

# Bridge → DB-GPT
DBGPT_BASE=http://127.0.0.1:5670
BRIDGE_PORT=8789
# BI_SOURCES_FILE=../configs/sources/local/connection.local.json
