# Copy to .env and adjust. Loaded by scripts/start.sh.
# Paths below are optional — start.sh defaults DBGPT_HOME to backend/.dbgpt

# DBGPT_HOME=  # absolute path; omit to use <backend>/.dbgpt
DBGPT_LANG=en
DBGPT_HOST=0.0.0.0
DBGPT_PORT=5670
DBGPT_ENCRYPT_KEY=nanobase-dbgpt-local-key

# OpenAI-compatible LLM (Nanobase default :8010)
OPENAI_API_BASE=http://127.0.0.1:8010/v1
OPENAI_API_KEY=nanobase-local
LLM_MODEL_NAME=nanobase-qwen36-35b-a3b-mtp
LLM_MODEL_PROVIDER=proxy/openai

# Embeddings — same OpenAI-compatible base if available; override if not
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_MODEL_PROVIDER=proxy/openai
EMBEDDING_MODEL_API_URL=http://127.0.0.1:8010/v1/embeddings
