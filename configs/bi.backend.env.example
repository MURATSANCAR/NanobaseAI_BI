# NanobaseAI BI Intelligence — standalone env (no QA runner jobs)
# Copy to configs/backend.env on BI server.

API_HOST=0.0.0.0
API_PORT=8789
API_KEY=change-me-to-a-long-random-secret

ENABLE_BI=true
PORTAL_MODULES=bi
AUTH_BRIDGE_URL=

LLM_API_BASE=http://127.0.0.1:8010/v1
LLM_API_KEY=nanobase-local
LLM_MODEL=nanobase-qwen36-35b-a3b-mtp
LLM_TIMEOUT_SEC=300
LLM_CONTEXT_WINDOW_TOKENS=8192
LLM_RESERVED_OUTPUT_TOKENS=2800

# Arctic Text2SQL (llama.cpp :8091) — POST /api/v1/bi/query/generate
TEXT2SQL_ENABLED=1
TEXT2SQL_API_BASE=http://127.0.0.1:8091/v1
TEXT2SQL_API_KEY=nanobase-local
TEXT2SQL_MODEL=arctic-text2sql
TEXT2SQL_TIMEOUT_SEC=45
TEXT2SQL_CANDIDATE_TABLES=24
TEXT2SQL_MAX_TABLES=12
TEXT2SQL_REPAIR_MAX=1
TEXT2SQL_REPLAN_MAX=1
TEXT2SQL_EXPLAIN_ENABLED=1
TEXT2SQL_MAX_COMPLETION_TOKENS=768
BI_PLANNER=qwen
BI_SQL_GENERATOR=arctic
BI_REPLAN=qwen
BI_USE_ARCTIC=1
# Semantic Layer stage-0 (catalog→binding→compiler). Miss → Day-1 Qwen/Arctic.
BI_SEMANTIC_LAYER_ENABLED=1

PORTAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://bi.nanobase.ai,https://portal.nanobase.ai
# PORTAL_STATIC_DIR=/data/nanobaseai/bi/portal/dist

BI_DIR=/data/nanobaseai/bi
BI_DATABASE_URL=
BI_QUERY_TIMEOUT_SEC=30
BI_MAX_ROWS=1000
BI_CRON_ENABLED=true
BI_SCHEMA_REFRESH_INTERVAL_MINUTES=5
BI_SHARE_DEFAULT_TTL_HOURS=72
BI_AUDIT_RETENTION_DAYS=90
# SaaS guardrails (Faz 0+)
BI_PUBLIC_SHARE_ENABLED=true
BI_DEMO_SEED_ENABLED=false
BI_DEFAULT_DENY_TABLES=true
BI_META_STORE=postgres
# BI_META_STORE=json   # PoC fallback only — do not use in production
# BI_META_DATABASE_URL=postgresql://bi_meta@127.0.0.1:5432/bi_meta
BI_QUEUE_ENABLED=false
BI_WORKER_SERVICE_TOKEN=
BI_SQL_MAX_JOINS=8
BI_SQL_MAX_CTE_DEPTH=4
BI_SQL_MAX_EXPLAIN_COST=1000000
BI_SQL_MAX_ESTIMATED_ROWS=5000000

# Primary canvas: Apache Superset only
BI_ENGINE_MODE=superset

# Apache Superset (primary published canvas)
BI_SUPERSET_ENABLED=true
BI_SUPERSET_URL=http://127.0.0.1:8089
# Public embed: https://portal.nanobase.ai:8443 + portal-analytics-8443.conf
BI_SUPERSET_PUBLIC_URL=https://portal.nanobase.ai:8443
BI_SUPERSET_USERNAME=nanobase-bi-svc
BI_SUPERSET_PASSWORD=
BI_SUPERSET_GUEST_SECRET=
# Must match GUEST_TOKEN_JWT_AUDIENCE in infra/docker/superset/superset_config.py
BI_SUPERSET_GUEST_AUDIENCE=http://0.0.0.0:8080/
BI_SUPERSET_GUEST_TTL_MIN=30
BI_SUPERSET_EMBED_DOMAINS=portal.nanobase.ai,bi.nanobase.ai,localhost,127.0.0.1

# Wow roadmap
BI_SNAPSHOT_ENABLED=true
BI_SNAPSHOT_MAX_METRICS=50
BI_ANOMALY_ZSCORE=2.5
BI_ANOMALY_MIN_HISTORY=7
BI_ANOMALY_PCT_THRESHOLD=10
BI_METRIC_POLICY=approved_or_certified
BI_SHARE_CHAT_ARTIFACTS=true
BI_PUBLIC_SHARE_SHOW_SQL=false
BI_RLS_INJECT_ENABLED=false
BI_DOMAIN_PACKS_DIR=
BI_EMBEDDING=
BI_EMBEDDING_URL=
BI_NOTIFY_SLACK_ENABLED=false
BI_NOTIFY_TEAMS_ENABLED=false
BI_EMBED_SDK_ENABLED=false

# Budget management (plan vs actual)
# Demo actuals SQL templates — keep false in production
BI_BUDGET_DEMO_TEMPLATES=false
# After scheduled actuals refresh, email digest to NOTIFY_EMAIL_TO
BI_BUDGET_DIGEST_ENABLED=true
# Digest language: en|tr|ru|uz — empty = resolve from portal BI users / default tr
BI_BUDGET_DIGEST_LOCALE=
# Digest scenario (base|optimistic|pessimistic) — default base to avoid double-count
BI_BUDGET_DIGEST_SCENARIO=base
# Optional reporting currency for digest KPI totals (empty = no FX convert)
BI_BUDGET_DIGEST_REPORTING_CURRENCY=
NOTIFY_EMAIL_TO=hello@nanobase.ai
# Public board-pack / team share links — default on; set false to disable
BI_PUBLIC_SHARE_ENABLED=true
# Enqueue daily budget actuals refresh via BI worker
BI_BUDGET_REFRESH_CRON=true
BI_BUDGET_HISTORY_RETENTION_DAYS=400
BI_BUDGET_HISTORY_MAX_POINTS=24

SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_API_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
