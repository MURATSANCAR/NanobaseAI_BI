# Supabase → BI Intelligence (copy values to server backend.env — NEVER commit secrets)
# Dashboard: https://supabase.com/dashboard/project/wmhjlyeaadvwtqtaossz/settings/database
#
# Auto-repair (no manual SQL Editor): set SUPABASE_ACCESS_TOKEN once from
# https://supabase.com/dashboard/account/tokens — deploy/configure applies grants automatically.

SUPABASE_PROJECT_REF=wmhjlyeaadvwtqtaossz
SUPABASE_URL=https://wmhjlyeaadvwtqtaossz.supabase.co
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Direct Postgres (optional if access token set — auto-synced after repair)
BI_DATABASE_URL=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@db.wmhjlyeaadvwtqtaossz.supabase.co:5432/postgres

BI_DIR=/data/nanobaseai-mobile/bi
BI_QUERY_TIMEOUT_SEC=30
BI_MAX_ROWS=1000

# Optional: Supabase anon/publishable key — NOT used for BI SQL (REST only)
# SUPABASE_ANON_KEY=sb_publishable_...
