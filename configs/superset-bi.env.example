# NanobaseAI analytics engine (Apache Superset) — LLM-controlled canvas
# Copy to /data/nanobaseai-mobile/configs/superset-bi.env on server.
# Also set matching BI_SUPERSET_* in backend.env (see configs/bi.backend.env.example).

BI_SUPERSET_ENABLED=1
BI_SUPERSET_URL=http://127.0.0.1:8089
# Public browser URL for embedded SDK (dedicated host — do NOT use portal /api host)
# Primary public embed URL (TLS on portal host port 8443 — no dedicated analytics DNS)
BI_SUPERSET_PUBLIC_URL=https://portal.nanobase.ai:8443
BI_SUPERSET_USERNAME=nanobase-bi-svc
BI_SUPERSET_PASSWORD=changeme
# Must match GUEST_TOKEN_JWT_SECRET in infra/docker/superset/superset_config.py
BI_SUPERSET_GUEST_SECRET=changeme_guest_jwt_secret_min_32_chars
# Must match GUEST_TOKEN_JWT_AUDIENCE in superset_config.py (NOT the public URL)
GUEST_TOKEN_JWT_AUDIENCE=http://0.0.0.0:8080/
BI_SUPERSET_GUEST_AUDIENCE=http://0.0.0.0:8080/
BI_SUPERSET_GUEST_TTL_MIN=30
BI_SUPERSET_EMBED_DOMAINS=portal.nanobase.ai,bi.nanobase.ai,localhost,127.0.0.1
# Default engine UI locale: tr | en | ru | uz
SUPERSET_DEFAULT_LOCALE=tr
SUPERSET_SECRET_KEY=nanobase_superset_change_me
# Comma-separated origins allowed to embed the analytics iframe (CORS)
SUPERSET_CORS_ORIGINS=https://portal.nanobase.ai,https://bi.nanobase.ai,http://localhost:5173,http://127.0.0.1:5173
