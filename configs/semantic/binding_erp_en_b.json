        }
      }
    ],
    "customer_count": [
      {
        "field": "account_code",
        "reason": "Business code is not distinct-id count",
        "profile": {
          "sample_values": ["A-1"],
          "comment": "Account code"
        }
      }
    ],
    "supplier_count": [
      {
        "field": "vendor_code",
        "reason": "Vendor code is not distinct-id count",
