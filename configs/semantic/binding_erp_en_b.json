      "comment": "Distinct supplier key"
    }
  },
  "measure_alternatives": {
    "invoice_total": [
      {
        "field": "net_amount",
        "reason": "Lookalike numeric — excludes tax",
        "profile": {
          "null_ratio": 0.0,
          "sample_values": [
            200.0,
            1600.0
          ],
          "comment": "Net of tax"
        }
      },
      {
        "field": "tax_included_total",
        "reason": "May double-count depending on ERP config",
        "profile": {
          "sample_values": [
            250.0
          ],
          "comment": "Ambiguous tax inclusion"
        }
      }
    ],
    "purchase_invoice_total": [
      {
        "field": "net_amount",
        "reason": "AP net lookalike",
        "profile": {
          "sample_values": [
            700.0
          ],
          "comment": "Net of tax"
        }
      }
    ],
    "payment_total": [
      {
        "field": "net_amount",
        "reason": "Receipt net lookalike",
        "profile": {
          "sample_values": [
            90.0
          ],
          "comment": "Net"
        }
      }
    ],
    "supplier_payment_total": [
      {
        "field": "net_amount",
        "reason": "Payment net lookalike",
        "profile": {
          "sample_values": [
            180.0
          ],
          "comment": "Net"
        }
      }
    ],
    "invoice_count": [
      {
        "field": "invoice_number",
        "reason": "Document number is not a row-count measure",
