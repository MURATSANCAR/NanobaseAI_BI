# Production: portal.nanobase.ai/bi → nanobase_api via /bi-api
VITE_API_BASE=/bi-api
VITE_BASE=/bi/
VITE_API_MODE=NANOBASE
VITE_USE_NANOBASE_BACKEND=true
VITE_ENABLE_SCHEMA_EXPLORER=true
VITE_ENABLE_SQL_PANEL=true
VITE_ENABLE_TEST_EXECUTION=false
VITE_ENABLE_FEEDBACK=true
VITE_ENABLE_EXPORTS=false
VITE_ENABLE_SEMANTIC_CATALOG=false

# Rollback (legacy bridge — usually stopped):
# VITE_API_MODE=LEGACY
