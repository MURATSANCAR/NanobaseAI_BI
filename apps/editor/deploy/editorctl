#!/usr/bin/env bash
# editorctl — editor stack on the TT GPU host. Everything lives under
# EDITOR_ROOT (/data/editor); nothing here touches BI containers or files.
#
#   editorctl install        dirs, secrets (once), rendered configs, Hermes home, image build
#   editorctl up             core services (Postgres, Qdrant, Temporal, gateway, MCP, worker, Hermes)
#   editorctl pause | resume "<neden>"   bakım kilidi + analiz servisleri (worker, mcp, gateway, embed, hermes)
#   editorctl down           stop every editor model container, then the core services
#   editorctl status         containers + gateway GPU/model status
#   editorctl models         model containers only
#   editorctl stop-models    stop every editor model now
#   editorctl analyze <pdf>  copy into the inbox and start a full analysis job
#   editorctl wait <job_id>  follow a job until it ends
#   editorctl queue          analyse every book in the inbox, one after another (detached)
#   editorctl cover <book_id> <image> <who>   set a book's cover (replaces the PDF stand-in)
#   editorctl cli ...        python -m editor.cli ... (review, report, canon)
#   editorctl hermes ...     hermes CLI inside the Hermes container
set -euo pipefail

ROOT=${EDITOR_ROOT:-/data/editor}
APP=$ROOT/app
COMPOSE=(docker compose -f "$APP/deploy/docker-compose.yml" --project-name editor)
export EDITOR_ROOT=$ROOT
# Every Python service runs the image of the version in this tree, unless told otherwise. The compose
# file has no default version on purpose (a missing variable used to mean a silent downgrade).
_ver=$(cat "$APP/VERSION" 2>/dev/null || true)
[ -n "$_ver" ] && export EDITOR_PY_IMAGE="${EDITOR_PY_IMAGE:-editor-py:$_ver}"
[ -n "${EDITOR_PY_IMAGE:-}" ] && export EDITOR_CARDS_IMAGE="${EDITOR_CARDS_IMAGE:-$EDITOR_PY_IMAGE}"

rand() { python3 -c "import secrets; print(secrets.token_urlsafe(${1:-32}))"; }

render() {  # render <template> <out>: ${VAR} from the secrets env files
  python3 - "$1" "$2" <<'PY'
import os, re, sys
env = {}
for f in ("editor.env", "postgres.env", "hermes.env"):
    p = os.path.join(os.environ["EDITOR_ROOT"], "secrets", f)
    for line in open(p):
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1); env[k] = v
src = open(sys.argv[1]).read()
keep = {"EDITOR_MCP_KEY"}          # resolved by Hermes at runtime from its env
out = re.sub(r"\$\{(\w+)\}", lambda m: m.group(0) if m.group(1) in keep else env[m.group(1)], src)
open(sys.argv[2], "w").write(out)
PY
}

cmd_install() {
  sudo mkdir -p "$ROOT"/{secrets,storage/inbox,pg,qdrant,temporal,hermes,vllm-cache,logs}
  sudo chown "$(id -u):$(id -g)" "$ROOT" "$ROOT"/{secrets,storage,storage/inbox,temporal,vllm-cache,logs}
  chmod 700 "$ROOT/secrets"
  if [ ! -f "$ROOT/secrets/editor.env" ]; then
    local pg_pw ed_pw tp_pw gw gwi mcp qd api
    pg_pw=$(rand); ed_pw=$(rand); tp_pw=$(rand); gw=$(rand); gwi=$(rand); mcp=$(rand); qd=$(rand); api=$(rand)
    umask 077
    cat > "$ROOT/secrets/postgres.env" <<EOF
POSTGRES_PASSWORD=$pg_pw
EDITOR_DB_PASSWORD=$ed_pw
TEMPORAL_DB_PASSWORD=$tp_pw
EOF
    cat > "$ROOT/secrets/qdrant.env" <<EOF
QDRANT__SERVICE__API_KEY=$qd
QDRANT__TELEMETRY_DISABLED=true
EOF
    cat > "$ROOT/secrets/editor.env" <<EOF
EDITOR_DB_DSN=postgresql://editor_app:$ed_pw@editor-postgres:5432/editor
EDITOR_GATEWAY_URL=http://editor-gateway:8000
EDITOR_GATEWAY_KEY=$gw
EDITOR_GATEWAY_INTERNAL_KEY=$gwi
EDITOR_MCP_KEY=$mcp
EDITOR_QDRANT_URL=http://editor-qdrant:6333
QDRANT__SERVICE__API_KEY=$qd
EDITOR_TEMPORAL_ADDRESS=editor-temporal:7233
EDITOR_TEMPORAL_NAMESPACE=editor
EDITOR_NETWORK=editor-net
EOF
    cat > "$ROOT/secrets/hermes.env" <<EOF
API_SERVER_KEY=$api
EDITOR_MCP_KEY=$mcp
EDITOR_GATEWAY_KEY=$gw
EOF
    umask 022
    echo "secrets created in $ROOT/secrets"
  fi
  # deployment settings that may be added after the first install (values are set on the host)
  #   EDITOR_COVER_WEB_SEARCH: publisher web site search URL with {isbn}, for cover lookup
  grep -q '^EDITOR_COVER_WEB_SEARCH=' "$ROOT/secrets/editor.env" || echo 'EDITOR_COVER_WEB_SEARCH=' >> "$ROOT/secrets/editor.env"
  # Interactive questions (Hermes) are answered by the same model on GPU 0 (BI's copy) while
  # the editor's own copy on GPU 1 is cold or the card is busy (user decision 2026-09-21).
  # Only Hermes overflows; analysis workers never do. Values can be changed on the host.
  grep -q '^EDITOR_OVERFLOW_URL=' "$ROOT/secrets/editor.env" || cat >> "$ROOT/secrets/editor.env" <<'EOV'
EDITOR_OVERFLOW_URL=http://172.17.0.1:8001
EDITOR_OVERFLOW_MODEL=nanobaseAI
EDITOR_OVERFLOW_CLIENTS=editor-hermes
EOV
  render "$APP/deploy/temporal/server.yaml.tpl" "$ROOT/temporal/server.yaml"
  chmod 644 "$ROOT/temporal/server.yaml"
  # Hermes home (uid 10000 in the image): config, persona, skills.
  sudo mkdir -p "$ROOT/hermes/skills"
  render "$APP/hermes/config.yaml.tpl" /tmp/editor-hermes-config.yaml
  sudo install -m 600 /tmp/editor-hermes-config.yaml "$ROOT/hermes/config.yaml"; rm -f /tmp/editor-hermes-config.yaml
  sudo install -m 644 "$APP/hermes/SOUL.md" "$ROOT/hermes/SOUL.md"
  sudo rm -rf "$ROOT/hermes/skills/book"
  sudo cp -r "$APP/hermes/skills/book" "$ROOT/hermes/skills/book"
  sudo chown -R 10000:10000 "$ROOT/hermes"
  local ver; ver=$(cat "$APP/VERSION" 2>/dev/null || echo dev)
  docker build -q -t "editor-py:$ver" -t editor-py:latest --build-arg CODE_VERSION="$ver" \
    -f "$APP/images/py/Dockerfile" "$APP"
  docker build -q -t editor-embed:latest -f "$APP/images/embed/Dockerfile" "$APP" >/dev/null
  docker build -q -t editor-upscale:1 -f "$APP/images/upscale/Dockerfile" "$APP" >/dev/null
  docker build -q -t editor-voice:1 -f "$APP/images/voice/Dockerfile" "$APP" >/dev/null
  echo "installed editor-py:$ver"
}

cmd_up() {
  # Analysis services are opt-in and the DB maintenance gate still applies.
  # Preserve stopped legacy/experimental containers for rollback.
  "${COMPOSE[@]}" up -d
}

cmd_stop_models() {
  local ids; ids=$(docker ps -q --filter label=editor.model)
  [ -n "$ids" ] && docker stop -t 30 $ids >/dev/null
  echo "editor models stopped"
}

cmd_down() {
  cmd_stop_models
  "${COMPOSE[@]}" stop
}

gw() {  # gw <path> [curl args]
  local key; key=$(grep ^EDITOR_GATEWAY_INTERNAL_KEY= "$ROOT/secrets/editor.env" | cut -d= -f2-)
  curl -fsS -H "authorization: Bearer $key" "http://127.0.0.1:19100$1" "${@:2}"
}

cmd_status() {
  "${COMPOSE[@]}" ps --format 'table {{.Name}}\t{{.Status}}'
  echo
  gw /internal/status | python3 -m json.tool || echo "gateway not reachable"
}

case "${1:-}" in
  install) cmd_install ;;
  up) cmd_up ;;
  down) cmd_down ;;
  status) cmd_status ;;
  models) docker ps -a --filter label=editor.model --format 'table {{.Names}}\t{{.Status}}' ;;
  foundation-status) docker exec editor-control python -m editor.foundation status ;;
  pause)
    docker exec editor-control python -m editor.foundation pause
    docker stop -t 30 editor-hermes editor-mcp editor-worker editor-gateway
    cmd_stop_models ;;
  resume)  # editorctl resume "<neden>": bakım kilidini kaldırır ve analiz servislerini açar
    docker exec editor-control python -m editor.foundation resume --reason "${2:-Analysis resumed}"
    "${COMPOSE[@]}" --profile analysis up -d ;;
  stop-models) cmd_stop_models ;;
  analyze)
    shift; f=$1; shift
    install -m 644 "$f" "$ROOT/storage/inbox/$(basename "$f")"
    docker exec editor-mcp python -m editor.cli analyze "$(basename "$f")" "$@" ;;
  wait) docker exec editor-mcp python -m editor.cli wait "$2" ;;
  queue)  # editorctl queue [--force|--code-version]: gelen kutusundaki her kitabı sırayla analiz eder
    shift
    # detached from this shell on purpose: the queue outlives the ssh session that starts it
    sudo systemd-run --unit=editor-queue --collect --description="editör kitap kuyruğu" \
      docker exec editor-mcp python -m editor.cli queue "$@"
    echo "kuyruk başladı: journalctl -u editor-queue -f" ;;
  cover)  # editorctl cover <book_id> <image file> <who>
    mkdir -p "$ROOT/storage/covers-inbox"
    install -m 644 "$3" "$ROOT/storage/covers-inbox/$(basename "$3")"
    docker exec editor-mcp python -m editor.cli cover "$2" "$(basename "$3")" --by "${4:?kim ekliyor}" ;;
  cli) shift; docker exec -i editor-mcp python -m editor.cli "$@" ;;
  hermes) shift; docker exec -it editor-hermes hermes "$@" ;;
  gw) shift; gw "$@" ;;
  *) sed -n '2,16p' "$0"; exit 2 ;;
esac
