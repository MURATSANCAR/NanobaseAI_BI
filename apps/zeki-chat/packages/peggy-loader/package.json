{
	"name": "@zeki.chat/peggy-loader",
	"version": "0.31.28",
	"description": "Peggy loader for webpack",
	"keywords": [
		"peggy",
		"loader",
		"webpack"
	],
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"/dist"
	],
	"scripts": {
		".:build:clean": "rimraf dist",
		".:build:tsc": "tsc -p tsconfig.build.json",
		"build": "run-s .:build:clean .:build:tsc",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@rocket.chat/prettier-config": "~0.31.25",
		"@types/node": "~22.19.17",
		"eslint": "~9.39.4",
		"npm-run-all": "^4.1.5",
		"peggy": "4.1.1",
		"prettier": "~3.3.3",
		"rimraf": "^6.0.1",
		"typescript": "~5.9.3",
		"webpack": "~5.104.1"
	},
	"peerDependencies": {
		"peggy": "*",
		"webpack": "*"
	},
	"volta": {
		"extends": "../../package.json"
	},
	"publishConfig": {
		"access": "public"
	}
}
