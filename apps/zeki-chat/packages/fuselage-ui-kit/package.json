{
	"name": "@zeki.chat/fuselage-ui-kit",
	"version": "31.0.0",
	"private": true,
	"description": "UiKit elements for ZEKI AI CHAT Apps built under Fuselage design system",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"/dist"
	],
	"scripts": {
		".:build-preview-move": "mkdir -p ../../.preview/ && cp -r ./storybook-static ../../.preview/fuselage-ui-kit",
		".:build:clean": "rimraf dist",
		".:build:tsc": "tsc -p tsconfig.build.json",
		"build": "run-s .:build:clean .:build:tsc",
		"build-preview": "yarn build-storybook",
		"build-storybook": "NODE_ENV=production storybook build",
		"dev": "tsc --watch --preserveWatchOutput -p tsconfig.build.json",
		"docs": "cross-env NODE_ENV=production storybook build -o ../../static/fuselage-ui-kit",
		"lint": "eslint .",
		"storybook": "storybook dev -p 6006 --no-version-updates",
		"test": "jest",
		"testunit": "jest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@zeki.chat/core-typings": "workspace:^",
		"@zeki.chat/gazzodown": "workspace:^",
		"@zeki.chat/ui-kit": "workspace:~"
	},
	"devDependencies": {
		"@zeki.chat/apps-engine": "workspace:^",
		"@zeki.chat/core-typings": "workspace:^",
		"@rocket.chat/emitter": "^0.32.0",
		"@rocket.chat/fuselage": "^0.78.0",
		"@rocket.chat/fuselage-hooks": "^0.41.0",
		"@rocket.chat/fuselage-tokens": "~0.33.2",
		"@rocket.chat/icons": "~0.47.0",
		"@zeki.chat/jest-presets": "workspace:~",
		"@zeki.chat/mock-providers": "workspace:^",
		"@rocket.chat/styled": "^0.33.0",
		"@zeki.chat/tsconfig": "workspace:*",
		"@zeki.chat/ui-avatar": "workspace:^",
		"@zeki.chat/ui-contexts": "workspace:^",
		"@zeki.chat/ui-kit": "workspace:~",
		"@zeki.chat/ui-video-conf": "workspace:^",
		"@storybook/addon-essentials": "^8.6.18",
		"@storybook/addon-styling-webpack": "^1.0.1",
		"@storybook/addon-webpack5-compiler-swc": "~3.0.0",
		"@storybook/blocks": "^8.6.18",
		"@storybook/react": "^8.6.18",
		"@storybook/react-webpack5": "^8.6.18",
		"@storybook/theming": "^8.6.18",
		"@tanstack/react-query": "~5.65.1",
		"@testing-library/dom": "~10.4.1",
		"@testing-library/react": "~16.3.2",
		"@testing-library/user-event": "~14.6.1",
		"@types/react": "~18.3.28",
		"@types/react-dom": "~18.3.7",
		"cross-env": "^7.0.3",
		"eslint": "~9.39.4",
		"i18next": "~23.4.9",
		"jest": "~30.2.0",
		"normalize.css": "^8.0.1",
		"npm-run-all": "^4.1.5",
		"prettier": "~3.3.3",
		"react": "~18.3.1",
		"react-dom": "~18.3.1",
		"react-i18next": "~13.2.2",
		"react-virtuoso": "~4.12.8",
		"rimraf": "^6.0.1",
		"storybook": "^8.6.18",
		"storybook-dark-mode": "^4.0.2",
		"typescript": "~5.9.3",
		"webpack": "~5.104.1"
	},
	"peerDependencies": {
		"@zeki.chat/apps-engine": "workspace:^",
		"@rocket.chat/fuselage": "*",
		"@rocket.chat/fuselage-hooks": "*",
		"@rocket.chat/icons": "*",
		"@rocket.chat/styled": "*",
		"@zeki.chat/ui-avatar": "workspace:^",
		"@zeki.chat/ui-contexts": "workspace:^",
		"@zeki.chat/ui-kit": "workspace:^",
		"@zeki.chat/ui-video-conf": "workspace:^",
		"@tanstack/react-query": "*",
		"i18next": "*",
		"react": "*",
		"react-dom": "*",
		"react-i18next": "*"
	},
	"volta": {
		"extends": "../../package.json"
	},
	"publishConfig": {
		"access": "public"
	}
}
