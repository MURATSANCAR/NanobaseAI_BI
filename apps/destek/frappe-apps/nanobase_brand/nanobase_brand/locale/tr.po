msgstr "Asistanın önce birkaç ayara ihtiyacı var:"

msgid "Create and enable a Flow Model with your provider credentials."
msgstr "Sağlayıcı bilgilerinizle bir NanobaseAI Modeli oluşturup etkinleştirin."

msgid "Enable a Flow Agent (Flow Agent is created automatically once a model exists)."
msgstr "Bir NanobaseAI Ajanı etkinleştirin (model eklenince ajan kendiliğinden oluşur)."

msgid "Enable Server Scripts in your site config so the assistant can run code."
msgstr "Asistanın kod çalıştırabilmesi için site ayarlarında sunucu betiklerini açın."

msgid "New chat"
msgstr "Yeni sohbet"

msgid "Full screen"
msgstr "Tam ekran"

msgid "Exit full screen"
msgstr "Tam ekrandan çık"

msgid "Close (Ctrl+I)"
msgstr "Kapat (Ctrl+I)"

msgid "Flow failed to load. Refresh the page to retry."
msgstr "NanobaseAI yüklenemedi. Yeniden denemek için sayfayı yenileyin."

msgid "Flow Model {0} is disabled."
msgstr "NanobaseAI Modeli {0} devre dışı."

msgid "Flow Agent {0} is disabled."
msgstr "NanobaseAI Ajanı {0} devre dışı."

msgid "You are not permitted to use Flow Model {0}."
msgstr "NanobaseAI Modeli {0} için yetkiniz yok."

msgid "Set an embedding model in Flow Knowledge Settings first."
msgstr "Önce Bilgi Bankası Ayarları'nda bir gömme modeli seçin."

msgid "Knowledge store is not initialized. Configure Flow Knowledge Settings and ingest a source."
msgstr "Bilgi deposu hazır değil. Bilgi Bankası Ayarları'nı yapın ve bir kaynak ekleyin."

msgid "The {0} agent is missing. Create a Flow Model first to auto-provision it."
msgstr "{0} ajanı yok. Kendiliğinden oluşması için önce bir NanobaseAI Modeli ekleyin."

