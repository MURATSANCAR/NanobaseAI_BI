MODEL_ALIAS=arctic-text2sql
MODEL_FILE=/data/nanobaseai/models/arctic-text2sql-r1-7b/Arctic-Text2SQL-R1-7B.Q5_K_M.gguf
LLAMA_SERVER_BIN=/opt/nanobaseai/bin/llama-server
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8091
CTX_SIZE=8192
# Keep Arctic lean; BI prod uses TEXT2SQL_PREFER=chat (Qwen). When Arctic is on, do not steal 24 cores.
THREADS=8
THREADS_BATCH=8
BATCH_SIZE=512
UBATCH_SIZE=128
PARALLEL=1
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
OMP_NUM_THREADS=8
OPENBLAS_NUM_THREADS=8
